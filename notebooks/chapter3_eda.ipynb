   "source": [
    "import pandas as pd\n",
    "def awscli_to_df():\n",
    "    json_df = pd.read_json('/tmp/awscli.json')\n",
    "    df = pd.DataFrame(json_df[0].tolist(), index = json_df.index, \\\n",
    "        columns = json_df[0].tolist()[0]).drop(0, axis = 0)\n",
    "    \n",
    "    return df"
   ]
  },
